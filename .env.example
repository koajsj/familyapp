# Copy to .env on the VPS, restrict it to root/familyapp administrators (0600),
# then replace every placeholder. Do not commit .env.
APP_ENV=production
DEBUG=false
OPENAPI_ENABLED=false
API_DOMAIN=api.example.com
ALLOWED_HOSTS=api.example.com
# Native iOS does not need CORS. Use a precise HTTPS web origin only if one is added.
CORS_ORIGINS=
MAX_REQUEST_BYTES=10485760
REMOTE_SYNC_ENABLED=true
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin
# Refuse deployment if the filesystem containing /opt/familyapp has less free space.
MIN_FREE_DISK_MB=2048
# HTTPS checks are finite and are shared by bootstrap, update, rollback, and CI.
HEALTHCHECK_RETRIES=12
HEALTHCHECK_INTERVAL=5
HEALTHCHECK_TIMEOUT=15
# Used once for idempotent provisioning of the fixed remote member records;
# required only when REMOTE_SYNC_ENABLED=true. Do not reuse a production secret.
FAMILYAPP_FIXED_MEMBER_PASSWORD=replace-with-remote-auth-password
FAMILYAPP_FAMILY_TIMEZONE=Asia/Shanghai

# Local PostgreSQL uses host `db`; for managed PostgreSQL replace the complete URL.
# POSTGRES_* is required only when DATABASE_URL points at the local `db` profile.
DATABASE_URL=postgresql+asyncpg://familyapp:replace-with-strong-password@db:5432/familyapp
POSTGRES_DB=familyapp
POSTGRES_USER=familyapp
POSTGRES_PASSWORD=replace-with-strong-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
FAMILYAPP_ACCESS_TOKEN_TTL_SECONDS=900
FAMILYAPP_REFRESH_TOKEN_TTL_SECONDS=2592000
# One-use recovery authorization, 60...3600 seconds; it is not a bearer token.
FAMILYAPP_RECOVERY_SESSION_TTL_SECONDS=600
FAMILYAPP_SYNC_RETENTION_DAYS=90
# Media assets use a private S3-compatible bucket. Leave `unconfigured` until
# all of the variables below are set; core API routes remain available.
FAMILYAPP_MEDIA_BACKEND=unconfigured
FAMILYAPP_MEDIA_S3_BUCKET=
FAMILYAPP_MEDIA_S3_REGION=
FAMILYAPP_MEDIA_S3_ENDPOINT_URL=
FAMILYAPP_MEDIA_S3_ACCESS_KEY_ID=
FAMILYAPP_MEDIA_S3_SECRET_ACCESS_KEY=
FAMILYAPP_MEDIA_S3_SESSION_TOKEN=
# `path` is commonly needed for MinIO; use `auto` for AWS/R2/B2 unless needed.
FAMILYAPP_MEDIA_S3_ADDRESSING_STYLE=auto
FAMILYAPP_MEDIA_S3_PRESIGN_SECONDS=900
FAMILYAPP_MEDIA_UPLOAD_EXPIRY_SECONDS=86400
FAMILYAPP_MEDIA_OBJECT_PREFIX=familyapp/private

# Backups are always written locally first. The three retention values keep the
# newest daily, weekly, and monthly snapshots; zero disables that tier.
BACKUP_DIR=/var/backups/familyapp
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=12
# Optional private S3-compatible backup upload. Leave all blank to keep local backups only.
S3_BACKUP_URI=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Never set true until a human has verified that the currently deployed schema
# is backward compatible with the target code. Database downgrades are never automatic.
ROLLBACK_SCHEMA_COMPATIBLE=false
