# Backend-only compatibility template. Production deployment uses the root
# .env.example; never commit a real secret or production URL.
DATABASE_URL=postgresql+asyncpg://familyapp:change-me@127.0.0.1:5432/familyapp
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
APP_ENV=development
DEBUG=false
API_DOMAIN=
ALLOWED_HOSTS=
CORS_ORIGINS=
OPENAPI_ENABLED=false
MAX_REQUEST_BYTES=10485760
REMOTE_SYNC_ENABLED=false
# Required only by `python -m app.provisioning` for a future remote rollout.
FAMILYAPP_FIXED_MEMBER_PASSWORD=
FAMILYAPP_ACCESS_TOKEN_TTL_SECONDS=900
FAMILYAPP_REFRESH_TOKEN_TTL_SECONDS=2592000
# One-use recovery authorization, 60...3600 seconds; it is not a bearer token.
FAMILYAPP_RECOVERY_SESSION_TTL_SECONDS=600
# Invitation grants only a pending application. Change this before enabling
# remote registration in production; the backend performs the final check.
FAMILYAPP_INVITE_CODE=zhangsan
# 1 hour ... 30 days. Expired applications are rejected without a Member/session.
FAMILYAPP_PENDING_REGISTRATION_TTL_SECONDS=604800
FAMILYAPP_SYNC_RETENTION_DAYS=90
FAMILYAPP_FAMILY_TIMEZONE=Asia/Shanghai
# `unconfigured` keeps the API available but media endpoints return 503.
# For AWS S3, R2, B2, MinIO, or another S3-compatible private bucket use `s3`.
FAMILYAPP_MEDIA_BACKEND=unconfigured
FAMILYAPP_MEDIA_S3_BUCKET=
FAMILYAPP_MEDIA_S3_REGION=
FAMILYAPP_MEDIA_S3_ENDPOINT_URL=
FAMILYAPP_MEDIA_S3_ACCESS_KEY_ID=
FAMILYAPP_MEDIA_S3_SECRET_ACCESS_KEY=
FAMILYAPP_MEDIA_S3_SESSION_TOKEN=
# auto, path, or virtual. MinIO commonly uses path.
FAMILYAPP_MEDIA_S3_ADDRESSING_STYLE=auto
FAMILYAPP_MEDIA_S3_PRESIGN_SECONDS=900
FAMILYAPP_MEDIA_UPLOAD_EXPIRY_SECONDS=86400
FAMILYAPP_MEDIA_OBJECT_PREFIX=familyapp/private
